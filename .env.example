# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA commite o arquivo ".env" de verdade em um repositório.

# Modo de resumo/classificação: "offline" (gratuito, padrão) ou "ai" (com custo pequeno)
SUMMARIZATION_MODE=offline

# Só é necessária se SUMMARIZATION_MODE=ai
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# E-mails separados por vírgula, sem espaço extra
RECIPIENTS=theo@integritywm.com.br,outro.integrante@integritywm.com.br
SENDER_EMAIL=theo@integritywm.com.br

# Senha de app do Gmail (NÃO é sua senha normal) -- gere em
# myaccount.google.com/apppasswords depois de ativar a verificação em
# duas etapas. Cole sem espaços.
GMAIL_APP_PASSWORD=abcdefghijklmnop

# URL pública onde o dashboard fica hospedado (GitHub Pages)
DASHBOARD_PUBLIC_URL=https://SEU-USUARIO.github.io/morning-call/

# URL do Web App do Google Apps Script (ver apps_script/feedback_webapp.gs)
FEEDBACK_WEBAPP_URL=https://script.google.com/macros/s/SEU_ID/exec

OUTPUT_HTML_PATH=./dist/index.html
